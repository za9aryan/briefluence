// Data model from the build spec. Additions beyond the spec are marked "spec+" with the reason.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  INFLUENCER
  BRAND
  ADMIN
}

enum Platform {
  INSTAGRAM
  TIKTOK
  YOUTUBE
}

/// How a social account got its numbers: platform API (OAuth) or typed in by the blogger.
enum AccountSource {
  OAUTH
  MANUAL
}

/// Every social account is checked by an admin (content, public profile) before it is used.
enum AccountReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum VerificationStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum GenderFilter {
  ANY
  MALE
  FEMALE
}

enum PaymentType {
  BARTER
  MONEY
  MIXED
}

enum CollaborationType {
  ONE_TIME
  LONG_TERM
}

enum ContactMethod {
  TELEGRAM
  MESSENGER
  VIBER
  WHATSAPP
  INSTAGRAM
  PHONE
}

enum Currency {
  AMD
  USD
  RUB
}

enum ContentFormat {
  POST
  REEL
  STORY
  SHORT_VIDEO
  LONG_VIDEO
  LIVE
  TEXT_MENTION
  INTEGRATION
  PRODUCT_PLACEMENT
  REVIEW
  GIVEAWAY
  EVENT
  UGC
}

enum DealStatus {
  DRAFT
  IN_REVIEW
  REJECTED
  ACTIVE
  PAUSED
  CLOSED
  EXPIRED
}

enum ApplicationStatus {
  APPLIED
  VIEWED
  SHORTLISTED
  ACCEPTED
  REJECTED
  WITHDRAWN
  COMPLETED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

/// Blogger plans (admin edits prices and the Basic limit in the Plans table).
enum PlanCode {
  BASIC
  PRO_MONTHLY
  PRO_YEARLY
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

model User {
  id              String             @id @default(cuid())
  email           String             @unique
  passwordHash    String? // null for accounts created with Google / Apple sign-in
  role            Role
  emailVerifiedAt DateTime?
  createdAt       DateTime           @default(now())
  blockedAt       DateTime? // spec+: admin moderation of users/brands
  digestEmails    Boolean            @default(true) // spec+: notification settings page
  currency        Currency           @default(AMD) // spec+: currency amounts are shown in
  locale          String             @default("en") // spec+: language for emails / notifications (en | ru | hy)
  influencer      InfluencerProfile?
  brand           BrandProfile?
  subscription    Subscription?
  notifications   Notification[]
  refreshTokens   RefreshToken[]
  identities      AuthIdentity[]
  accountLinks    SocialAccountLink[]
}

// spec+: refresh token rotation with reuse detection needs server-side state.
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique // sha256 of the opaque token
  familyId  String // all rotations of one login share a family; reuse revokes the family
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
}

model InfluencerProfile {
  id              String             @id @default(cuid())
  userId          String             @unique
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName     String
  avatarUrl       String?
  bio             String?
  country         String // ISO 3166-1 alpha-2, e.g. "AM"
  city            String?
  gender          Gender?
  birthYear       Int?
  languages       String[] // ISO 639-1
  niches          String[] // from a fixed category list
  contactMethod   ContactMethod? // spec+: replaces contactEmail / contactPhone / telegram
  contactValue    String?
  status          VerificationStatus @default(DRAFT)
  rejectionReason String?
  approvedAt      DateTime?
  submittedAt     DateTime? // spec+: review queue ordering
  profileViews    Int                @default(0) // spec+: dashboard stat
  savedFilters    Json? // spec+: saved feed filters
  /// Optional "About your work" answers; brands see only the filled ones.
  faqBrandsWorked String?
  faqAudience     String?
  faqBrandsWanted String?
  createdAt       DateTime           @default(now())
  socialAccounts  SocialAccount[]
  applications    Application[]
  offers          Offer[]
  portfolio       PortfolioItem[]

  @@index([status])
}

model SocialAccount {
  id                String            @id @default(cuid())
  influencerId      String
  influencer        InfluencerProfile @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  platform          Platform
  externalId        String
  username          String
  profileUrl        String
  avatarUrl         String? // spec+
  mediaCount        Int? // spec+
  followers         Int
  avgViews          Int?
  engagementRate    Float? // percent
  audienceGender    Json? // { male: 38.2, female: 61.8 }
  audienceAge       Json? // { "18-24": 30.1, "25-34": 41.0, ... }
  audienceCountries Json? // { "AM": 72.4, "RU": 9.1, ... }
  source            AccountSource     @default(OAUTH) // spec+
  reviewStatus      AccountReviewStatus @default(PENDING) // spec+
  reviewNote        String? // admin's reason when rejected
  reviewedAt        DateTime?
  reuseReviewedAt   DateTime? // admin looked at the re-registration warning and allowed it
  links             SocialAccountLink[]
  accessTokenEnc    String? // AES-256-GCM encrypted; null for MANUAL accounts
  refreshTokenEnc   String?
  tokenExpiresAt    DateTime?
  tokenRevokedAt    DateTime? // spec+: flagged when a sync finds the token revoked
  lastSyncedAt      DateTime?
  createdAt         DateTime          @default(now())

  @@unique([platform, externalId])
  @@unique([influencerId, platform]) // one account per platform per blogger
  @@index([reviewStatus])
}

model BrandProfile {
  id              String         @id @default(cuid())
  userId          String         @unique
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName     String
  logoUrl         String?
  website         String?
  instagramUrl    String?
  description     String?
  country         String
  city            String?
  contactName     String?
  contactPosition String? // spec+
  contactMethod   ContactMethod? // spec+: replaces contactPhone / contactEmail
  contactValue    String? // normalized: +digits for phones, username without @
  createdAt       DateTime       @default(now())
  deals           Deal[]
  offerRequests   OfferRequest[]
  offerViews      OfferView[]
}

model Deal {
  id                  String            @id @default(cuid())
  brandId             String
  brand               BrandProfile      @relation(fields: [brandId], references: [id], onDelete: Cascade)
  title               String
  description         String
  imageUrl            String?
  platforms           Platform[]
  contentFormats      ContentFormat[]
  niches              String[]
  collaborationType   CollaborationType @default(ONE_TIME) // spec+
  isConfidential      Boolean           @default(false) // spec+: brand hidden from bloggers until accepted
  viewCount           Int               @default(0) // spec+: unique blogger views per day
  countries           String[]
  cities              String[]
  languages           String[]
  minFollowers        Int?
  maxFollowers        Int?
  minEngagementRate   Float?
  influencerGender    GenderFilter      @default(ANY)
  influencerAgeMin    Int?
  influencerAgeMax    Int?
  audienceGender      GenderFilter      @default(ANY) // majority gender of followers
  audienceAgeMin      Int?
  audienceAgeMax      Int?
  audienceCountry     String? // main follower country
  paymentType         PaymentType
  budgetMin           Int? // minor units
  budgetMax           Int? // minor units
  currency            Currency          @default(AMD)
  barterDescription   String?
  barterValue         Int? // minor units
  slots               Int               @default(1) // influencers needed
  applicationDeadline DateTime
  publishBy           DateTime?
  status              DealStatus        @default(DRAFT)
  publishedAt         DateTime? // spec+: "new deals matching you" digest
  /// Brief moderation: when it was sent for review, the admin's reason when sent back,
  /// and a fingerprint of the content the admin approved (see dealReviewKey).
  submittedAt         DateTime?
  reviewedAt          DateTime?
  reviewNote          String?
  approvedKey         String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @default(now()) @updatedAt // spec+
  applications        Application[]
  views               DealView[]

  @@index([status, applicationDeadline])
  @@index([status, submittedAt])
  @@index([brandId])
}

model Application {
  id              String            @id @default(cuid())
  dealId          String
  deal            Deal              @relation(fields: [dealId], references: [id], onDelete: Cascade)
  influencerId    String
  influencer      InfluencerProfile @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  socialAccountId String
  pitch           String
  proposedPrice   Int? // minor units, in the deal's currency
  matchScore      Int // 0-100, frozen at apply time
  status          ApplicationStatus @default(APPLIED)
  /// When the brand shortlisted / accepted it (kept after later status changes, for the funnel).
  shortlistedAt   DateTime?
  acceptedAt      DateTime?
  rejectionReason String?
  postUrl         String? // proof of publication
  /// Portfolio items the blogger attached when applying (approved ones only).
  portfolioItems  PortfolioItem[]   @relation("ApplicationPortfolio")
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([dealId, influencerId])
  @@index([influencerId])
  @@index([dealId, status])
}

/// A piece of past work: one image, a title, optional description and link. Reviewed by an admin
/// before brands see it; any edit sends it back to review.
model PortfolioItem {
  id           String              @id @default(cuid())
  influencerId String
  influencer   InfluencerProfile   @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  imageUrl     String
  title        String
  description  String?
  linkUrl      String?
  reviewStatus AccountReviewStatus @default(PENDING)
  reviewNote   String?
  reviewedAt   DateTime?
  applications Application[]       @relation("ApplicationPortfolio")
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([influencerId])
  @@index([reviewStatus])
}

model Subscription {
  id                  String             @id @default(cuid())
  userId              String             @unique
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  status              SubscriptionStatus
  /// Chosen / current plan. Free Pro days come first for every plan; unpaid Pro falls back to BASIC.
  planCode            PlanCode           @default(BASIC)
  /// Pro plan to switch to at the next renewal (monthly <-> yearly)
  nextPlanCode        PlanCode?
  /// When the blogger moved to Basic; its limit counts applications from then on.
  basicSince          DateTime?
  trialEndsAt         DateTime
  currentPeriodEnd    DateTime?
  cancelAtPeriodEnd   Boolean            @default(false)
  bindingId           String? // Ameriabank card binding (CardHolderID) for recurring charges
  cardMask            String?
  failedAttempts      Int                @default(0) // spec+: renewal retries on days 1, 3, 5
  pastDueSince        DateTime? // spec+
  trialReminderSentAt DateTime? // spec+: send the 3-day reminder once
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @default(now()) @updatedAt
  payments            Payment[]
}

model Payment {
  id                String        @id @default(cuid())
  subscriptionId    String
  subscription      Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  orderNumber       Int           @unique @default(autoincrement()) // spec+: Ameria OrderID must be an integer
  kind              String        @default("checkout") // spec+: "checkout" | "renewal"
  planCode          PlanCode? // spec+: which plan this payment was for
  amount            Int // minor units
  currency          Currency
  provider          String // "ameriabank" | "mock"
  providerOrderId   String        @unique
  providerPaymentId String?
  status            PaymentStatus @default(PENDING)
  failureReason     String? // spec+
  raw               Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @default(now()) @updatedAt

  @@index([subscriptionId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  params    Json? // spec+: raw values to render the text in the reader's language
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

// spec+: anonymous log of the filters bloggers use in the deal feed, aggregated for brand insights.
// Only aggregates are ever exposed; never which blogger searched for what.
model FeedSearch {
  id                 String              @id @default(cuid())
  influencerId       String
  platforms          Platform[]
  niches             String[]
  cities             String[]
  paymentTypes       PaymentType[]
  collaborationTypes CollaborationType[]
  budgetMin          Int? // minor units, AMD
  createdAt          DateTime            @default(now())

  @@index([createdAt])
  @@index([influencerId, createdAt])
}

// spec+: latest exchange rate per currency, as AMD per 1 unit (Central Bank of Armenia format).
model ExchangeRate {
  currency   Currency @id
  amdPerUnit Float
  source     String // "cba" | "open.er-api" | "fallback"
  fetchedAt  DateTime
}

// spec+: a blogger opened a brief (counted once per blogger per day, Yerevan time).
model DealView {
  id           String   @id @default(cuid())
  dealId       String
  deal         Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  influencerId String
  day          String // YYYY-MM-DD in Asia/Yerevan
  createdAt    DateTime @default(now())

  @@unique([dealId, influencerId, day])
  @@index([dealId, createdAt])
}

// spec+: "Sign in with Google / Apple" identities linked to a user.
model AuthIdentity {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider  String // "google" | "apple"
  subject   String // the provider's stable user id ("sub")
  email     String?
  createdAt DateTime @default(now())

  @@unique([provider, subject])
  @@index([userId])
}

/// spec+: every time a social account is linked to a profile. Kept after the account or the user is
/// deleted (ids become null; email/name stay as a snapshot) so admins can spot re-registrations.
model SocialAccountLink {
  id              String         @id @default(cuid())
  platform        Platform
  handle          String // lower-case username without @
  externalId      String? // platform id for connected accounts
  socialAccountId String?
  socialAccount   SocialAccount? @relation(fields: [socialAccountId], references: [id], onDelete: SetNull)
  userId          String?
  user            User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  email           String
  displayName     String?
  linkedAt        DateTime       @default(now())
  unlinkedAt      DateTime?

  @@index([platform, handle])
  @@index([platform, externalId])
  @@index([socialAccountId])
}

/// spec+: plan settings managed by admins. BASIC is free; its limit is applications per 30 days.
model Plan {
  code             PlanCode @id
  priceMinor       Int
  currency         Currency
  /// Applications per rolling 30 days; null = unlimited (Pro).
  applicationLimit Int?
  /// Live offers (in review, active, paused) a blogger may have; null = unlimited.
  offerLimit       Int?
  isActive         Boolean  @default(true)
  updatedAt        DateTime @default(now()) @updatedAt
}

/// spec+: what a blogger offers brands ("1 Story for 10,000 AMD"). Moderated like briefs.
enum OfferStatus {
  DRAFT
  IN_REVIEW
  REJECTED
  ACTIVE
  PAUSED
  CLOSED
}

enum OfferRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  WITHDRAWN
}

model Offer {
  id                String            @id @default(cuid())
  influencerId      String
  influencer        InfluencerProfile @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  title             String
  description       String
  /// null = price on request
  priceMinor        Int?
  currency          Currency          @default(AMD)
  collaborationType CollaborationType @default(ONE_TIME)
  platforms         Platform[]
  contentFormats    ContentFormat[]
  niches            String[]
  /// Who the blogger wants to work with, e.g. "real estate brokers"
  idealBrands       String?
  /// Optional cover image (our own upload, kind "offer")
  imageUrl          String?
  status            OfferStatus       @default(DRAFT)
  submittedAt       DateTime?
  reviewedAt        DateTime?
  reviewNote        String?
  approvedKey       String?
  publishedAt       DateTime?
  viewCount         Int               @default(0)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @default(now()) @updatedAt
  requests          OfferRequest[]
  views             OfferView[]

  @@index([status, publishedAt])
  @@index([influencerId])
}

/// A request from a brand to work with a blogger on one of their offers.
model OfferRequest {
  id             String             @id @default(cuid())
  offerId        String
  offer          Offer              @relation(fields: [offerId], references: [id], onDelete: Cascade)
  brandId        String
  brand          BrandProfile       @relation(fields: [brandId], references: [id], onDelete: Cascade)
  message        String
  /// Optional budget the brand proposes (offer currency, minor units)
  proposedBudget Int?
  status         OfferRequestStatus @default(PENDING)
  decidedAt      DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @default(now()) @updatedAt

  @@unique([offerId, brandId])
  @@index([brandId])
}

/// One view per brand per offer per Yerevan day (like DealView).
model OfferView {
  id        String       @id @default(cuid())
  offerId   String
  offer     Offer        @relation(fields: [offerId], references: [id], onDelete: Cascade)
  brandId   String
  brand     BrandProfile @relation(fields: [brandId], references: [id], onDelete: Cascade)
  day       String
  createdAt DateTime     @default(now())

  @@unique([offerId, brandId, day])
  @@index([offerId, createdAt])
}
