# ─── General ──────────────────────────────────────────────
NODE_ENV=development
# Public URLs (no trailing slash)
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PORT=4000
# Comma-separated origins allowed by CORS
CORS_ORIGINS=http://localhost:3000

# ─── Database / Redis ─────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/briefluence
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/briefluence_test
# Leave empty to run jobs in-process without Redis (dev only). Set to use BullMQ.
REDIS_URL=
# "all" = API also runs queue workers and cron; "api" = HTTP only (use a separate worker process)
PROCESS_ROLE=all

# ─── Auth ─────────────────────────────────────────────────
# Generate each with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_EMAIL_SECRET=change-me-email-secret-at-least-32-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Cookie domain, e.g. .briefluence.am in production; empty for localhost
COOKIE_DOMAIN=
COOKIE_SECURE=false
# Seeded admin account
ADMIN_EMAIL=admin@briefluence.local
ADMIN_PASSWORD=Admin12345

# ─── Encryption ───────────────────────────────────────────
# 32 bytes, base64. Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# ─── Email ────────────────────────────────────────────────
# smtp | resend | log  ("log" prints emails to the console and saves them to apps/api/.emails)
EMAIL_TRANSPORT=log
EMAIL_FROM="Briefluence <no-reply@briefluence.local>"
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
RESEND_API_KEY=

# ─── File storage ─────────────────────────────────────────
# s3 | local ("local" stores files in apps/api/uploads and serves them from the API)
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL of the bucket, e.g. https://cdn.briefluence.am
S3_PUBLIC_URL=

# ─── Social OAuth ─────────────────────────────────────────
# Fake OAuth with generated stats, per platform: true = all, false = none (real apps),
# or a list like "tiktok,youtube" (real Instagram, the rest simulated). Must be false in production.
# Setup guide for the real apps: docs/social-oauth-setup.md
SOCIAL_MOCK=true
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_GRAPH_VERSION=v23.0
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Sign in with Google / Apple ──────────────────────────
# Simulated sign-in for local testing: true = both, false = real ones, or a list like "apple".
# Real Google sign-in reuses GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET (add redirect URI
# {WEB_URL}/api/v1/auth/oauth/google/callback). Apple needs a Services ID + Sign in with Apple key
# (redirect URI {WEB_URL}/api/v1/auth/oauth/apple/callback, HTTPS only). Setup: docs/social-login-setup.md
OAUTH_LOGIN_MOCK=true
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Contents of the .p8 key file on one line, with \n for line breaks
APPLE_PRIVATE_KEY=

# ─── Payments ─────────────────────────────────────────────
# mock | ameriabank
PAYMENT_PROVIDER=mock
# Subscription price in minor units and currency (ask Ameria whether USD is allowed; else AMD 390000)
SUBSCRIPTION_PRICE_MINOR=999
SUBSCRIPTION_CURRENCY=USD
AMERIA_TEST_MODE=true
AMERIA_CLIENT_ID=
AMERIA_USERNAME=
AMERIA_PASSWORD=
# Ameria OrderIDs are integers; test terminals accept a bank-assigned range. OrderID = offset + payment number.
AMERIA_ORDER_ID_OFFSET=0
# PaymentType for MakeBindingPayment (6 = BindingMainRest per ameria-sdk-js; confirm with the bank)
AMERIA_BINDING_PAYMENT_TYPE=6

# ─── Observability ────────────────────────────────────────
SENTRY_DSN=

# ─── Web (Next.js) ────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SENTRY_DSN=
