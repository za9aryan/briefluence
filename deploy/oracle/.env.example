# Copy to .env on the server (cp .env.example .env) and fill in. Never commit .env.

# Your site address without https://, e.g. briefluence.am — or, before you have a domain,
# <server-ip-with-dashes>.sslip.io (e.g. 158-180-12-34.sslip.io).
DOMAIN=CHANGE_ME
WEB_URL=https://CHANGE_ME
API_URL=https://CHANGE_ME
CORS_ORIGINS=https://CHANGE_ME
COOKIE_SECURE=true

# Generate each secret on the server:  openssl rand -hex 32   (database: openssl rand -hex 24)
POSTGRES_PASSWORD=CHANGE_ME
JWT_ACCESS_SECRET=CHANGE_ME
JWT_EMAIL_SECRET=CHANGE_ME
# 32 random bytes, base64:  openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=CHANGE_ME

# First admin (created with: ./deploy/oracle/admin.sh). Use a strong password.
ADMIN_EMAIL=CHANGE_ME
ADMIN_PASSWORD=CHANGE_ME

# Email. "log" keeps emails inside the server (nothing is sent). For real emails create a
# free Resend account, verify your domain, then: EMAIL_TRANSPORT=resend and RESEND_API_KEY=...
EMAIL_TRANSPORT=log
EMAIL_FROM=briefluence <no-reply@CHANGE_ME>
RESEND_API_KEY=

# Uploaded images are stored on the server (backed up by backup.sh).
STORAGE_DRIVER=local

# Exchange rates from the Central Bank of Armenia.
RATES_SOURCE=cba

# Early launch: simulated social login, Google/Apple sign-in and payments until the real
# apps and Paddle are approved. Switch each off as its keys arrive.
ALLOW_MOCKS_IN_PRODUCTION=true
SOCIAL_MOCK=true
OAUTH_LOGIN_MOCK=true
PAYMENT_PROVIDER=mock

INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Paddle (blogger Pro payments). PAYMENT_PROVIDER=paddle turns it on. PADDLE_ENV=sandbox is the
# demo: 1 hour of free Pro, a 1-day price, test cards and admin "simulate" buttons. Going live =
# fill the PADDLE_LIVE_* lines and set PADDLE_ENV=production. See docs/paddle.md.
PADDLE_ENV=sandbox
PADDLE_SANDBOX_API_KEY=
PADDLE_SANDBOX_CLIENT_TOKEN=
PADDLE_SANDBOX_WEBHOOK_SECRET=
PADDLE_SANDBOX_PRICE_DEMO=
PADDLE_SANDBOX_PRICE_MONTHLY=
PADDLE_SANDBOX_PRICE_YEARLY=
PADDLE_LIVE_API_KEY=
PADDLE_LIVE_CLIENT_TOKEN=
PADDLE_LIVE_WEBHOOK_SECRET=
PADDLE_LIVE_PRICE_MONTHLY=
PADDLE_LIVE_PRICE_YEARLY=

# Web Push notifications (PWA). Generate once on the server, see docs/oracle-deploy.md.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@briefluence.am

# City search (GeoNames free web services; the username is not a secret). Empty = built-in city list.
GEONAMES_USERNAME=briefluence
